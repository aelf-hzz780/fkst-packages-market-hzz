# Copy this file to .fkst/env (gitignored) and fill in local values:
#   cp .fkst/env.example .fkst/env

# Path to a locally built fkst-framework binary.
# Example:
# BIN=/path/to/fkst-substrate/target/debug/fkst-framework
BIN=

# Optional source for exporting the official github-proxy package during
# local composed tests. The default is a pinned public FKST package source.
# FKST_OFFICIAL_PACKAGE_SOURCE_URL=https://github.com/ChronoAIProject/fkst-hosted.git
# FKST_OFFICIAL_PACKAGE_SOURCE_REF=28563dd34e5eb4d4a481bd0e630d41378d49b3f6

# GitHub issue source for local live runs.
# FKST_GITHUB_REPO=owner/repo
# FKST_GITHUB_WRITE=1

# X publishing authority. Keep real values only in .fkst/env or a FKST
# Environment Profile; never commit them.
# X_PUBLISH_WRITE=1
# NYXID_URL=https://nyxid.example.com
# NYXID_X_SERVICE_SLUG=x-service-slug
# X_PUBLISH_EXPECTED_USERNAME=expected-x-username
# NYXID_ACCESS_TOKEN=nyxid-agent-access-token

# LLM runtime configuration, if the host/session requires it.
# LLM_API_KEY=provider-key
# LLM_BASE_URL=https://provider.example.com/v1
# LLM_MODEL=model-name

# Runtime roots. Defaults are under ignored .fkst/run when unset.
# FKST_RUNTIME_ROOT=/path/to/runtime
# FKST_DURABLE_ROOT=/path/to/durable
# FKST_RATE_POOL_ROOT=/path/to/rate-pools
