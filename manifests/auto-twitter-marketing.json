{
  "schemaVersion": 1,
  "name": "auto-twitter-marketing",
  "description": "Business-only GitHub issue driven Auto Twitter marketing workflow for FKST hosted multi-workspace package import. Shadow mode previews by default; live X Post and Quote publishing is gated by the user's Environment Profile and brokered by NyxID.",
  "packages": [
    "aelf-hzz780/fkst-packages-market-hzz@v0.2.1:packages/x-publisher",
    "aelf-hzz780/fkst-packages-market-hzz@v0.2.1:packages/github-auto-twitter-marketing",
    "aelf-hzz780/fkst-packages-market-hzz@v0.2.1:packages/marketing-radar"
  ],
  "github": {
    "workLabels": [
      "auto-twitter-marketing"
    ]
  },
  "nyxid": {
    "xPublishCredential": "user-environment-profile",
    "xPublishRuntimeDependency": "nyxid-cli-on-path",
    "xPublishAccessTokenEnv": "NYXID_ACCESS_TOKEN",
    "xPublishBaseUrlEnv": "NYXID_URL",
    "xPublishServiceEnv": "NYXID_X_SERVICE_SLUG",
    "xPublishWriteSwitchEnv": "X_PUBLISH_WRITE",
    "xPublishExpectedUsernameEnv": "X_PUBLISH_EXPECTED_USERNAME",
    "xPublishNativeQuoteCapabilityEnv": "X_PUBLISH_NATIVE_QUOTE",
    "xPublishNativeQuotePackageEnv": "FKST_X_PUBLISH_NATIVE_QUOTE",
    "rawTokenPolicy": "forbidden-in-repo-manifest-issue-payload"
  },
  "workflow": {
    "strategyIssueType": "strategy",
    "weeklyContentIssueType": "weekly-content",
    "schedulePublishIssueType": "schedule-publish",
    "recurringSchedulePublishIssueType": "recurring-schedule-publish",
    "radarConfigIssueType": "radar-config",
    "radarSignalIssueType": "radar-signal",
    "radarRunIssueType": "radar-run",
    "radarGeneratedWeeklyContent": true,
    "radarGeneratedScheduleWhenCalendarRefKnown": true,
    "radarGeneratedIssueNumberReturn": false,
    "recurrenceField": "recurrence",
    "intervalMinutesField": "interval-minutes",
    "intervalRecurringScheduleType": "every-minutes",
    "dailyPublishTimeField": "time",
    "timezoneField": "timezone",
    "livePublishMode": "live",
    "contentRefField": "calendar-ref",
    "supportedXOperations": ["post", "quote"],
    "supportedXQuoteModes": ["native", "link"],
    "quoteOperationField": "operation",
    "quoteModeField": "quote-mode",
    "quoteUrlField": "quote-url",
    "mvpPublishSurface": "text-only-post-and-quote",
    "scheduleDispatch": "github-observed-resync"
  }
}
